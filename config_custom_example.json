{
    "case_name": "Custom-Geometry-Example",

    "geometry_mode": "custom",

    "custom_geometry": {
        "body_points_file": "geometry/my_body_points.csv",
        "L_0_override": 1.0e-6,
        "alpha_0": 0,
        "eps_body": null,

        "attachment_sites": [
            {
                "position": [-1.0e-6, 0, 0],
                "direction": [-1, 0, 0],
                "label": "left_pole"
            },
            {
                "position": [1.0e-6, 0, 0],
                "direction": [1, 0, 0],
                "label": "right_pole"
            }
        ],

        "pili": [
            {
                "points_file": "geometry/my_pilus_1_centerline.csv",
                "site_index": 1,
                "deflection_z": 0,
                "deflection_x": 0
            },
            {
                "points_file": "geometry/my_pilus_2_centerline.csv",
                "site_index": 2,
                "deflection_z": 0.1,
                "deflection_x": 0
            }
        ]
    },

    "material": {
        "E": 3.279e8,
        "r_pili": 3e-9,
        "sigma_p": 0.2
    },

    "fluid": {
        "mu": 1e-3,
        "rho_bac": 1180.0,
        "rho_fluid": 998.232
    },

    "simulation": {
        "T_obs": 30.0,
        "AbsTol": 1e-4,
        "RelTol": 1e-4,
        "delta_frac": 20,
        "tlim": 3600,
        "dt": 0.1,
        "seg_per_um": 10
    },

    "brownian": {
        "enable": false,
        "temperature": 293.15,
        "dt_B_ratio": 0.5,
        "fixman_midpoint": false
    },

    "output": {
        "preview_initial": true,
        "generate_animation": true,
        "animation_fps": 30,
        "animation_skip": 1,
        "auto_confirm": false,
        "compute_flowfield": true
    },

    "flowfield": {
        "grid_spacing_um": 0.05,
        "grid_range_um": 10.0,
        "quiver_skip": 5,
        "chunk_size": 2000
    },

    "background_flow": {
        "type": "off",
        "U_max": 0,
        "direction": [1, 0, 0],
        "shear_axis": [0, 0, 1],
        "shear_height_m": 0
    }
}
