{
    "case_name": "Motor-Driven-Flagella-Example",

    "body": {
        "minor_axis": 0.4e-6,
        "major_axis": 1.25e-6,
        "N_body": 300,
        "alpha_0": 0
    },

    "pili": [
        {
            "_comment": "Clamped pilus (standard, no motor)",
            "type": "linear",
            "length_um": 3,
            "site": 1,
            "intrinsic_curvature": "frozen",
            "active_moment": {
                "type": "off"
            }
        },
        {
            "_comment": "Motor-driven rotating flagellum with free-torsion coupling",
            "type": "linear",
            "length_um": 5,
            "site": 6,
            "intrinsic_curvature": "frozen",
            "active_moment": {
                "type": "off"
            },
            "root_coupling": "free_torsion",
            "motor_torque": {
                "type": "constant",
                "torque_pN_nm": 20,
                "max_omega_Hz": 300
            }
        }
    ],

    "material": {
        "E": 3.279e8,
        "r_pili": 3e-9,
        "sigma_p": 0.2
    },

    "fluid": {
        "mu": 1e-3,
        "rho_bac": 1180.0,
        "rho_fluid": 998.232
    },

    "simulation": {
        "_comment_T_obs": "v7.2.0 raised T_obs from 0.5 s to 1.0 s so the motor speed-limiting transient develops fully (omega rises from 0 to ~max_omega_Hz over a few milliseconds; the rotor then spins at near-stall speed for the remainder, giving a clearly-visible flagellum rotation in the animation).",
        "T_obs": 1.0,
        "AbsTol": 1e-4,
        "RelTol": 1e-4,
        "delta_frac": 20,
        "tlim": 3600,
        "_comment_dt": "v7.2.0 reduced dt from 0.1 s to 0.001 s. For max_omega_Hz = 300 Hz the rotation period is ~3.33 ms, so dt = 1 ms gives ~3 frames per rotation — a workable animation cadence (further reduction yields smoother frames at proportionally higher cost). dt only sets the post-processing sampling stride; ode15s adapts its internal step automatically.",
        "dt": 0.001,
        "seg_per_um": 10
    },

    "brownian": {
        "enable": false,
        "temperature": 293.15,
        "dt_B_ratio": 0.5
    },

    "output": {
        "preview_initial": true,
        "generate_animation": true,
        "animation_fps": 30,
        "animation_skip": 1,
        "auto_confirm": false,
        "compute_flowfield": true
    },

    "flowfield": {
        "grid_spacing_um": 0.05,
        "grid_range_um": 10.0,
        "quiver_skip": 5,
        "chunk_size": 2000
    },

    "background_flow": {
        "type": "off",
        "U_max": 0,
        "direction": [1, 0, 0],
        "shear_axis": [0, 0, 1],
        "shear_height_m": 0
    }
}
