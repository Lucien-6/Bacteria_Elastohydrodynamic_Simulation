{
    "case_name": "Custom-Geometry-Example",

    "geometry_mode": "custom",

    "_comment_geometry": [
        "Paths are relative to the project root (run_simulation.m addpath policy).",
        "Re-generate these files with geometry/generate_example_geometry.m or the",
        "pre-shipped CSV copies in geometry/ after cloning.",
        "Imported centerlines may have nonuniform source spacing; they are converted",
        "once to endpoint-preserving equal-chord canonical polygons."
    ],

    "custom_geometry": {
        "body_points_file": "geometry/example_body_capsule.csv",
        "L_0_override": null,
        "L_0_suggest_mode": "volume",
        "eps_body": null,

        "_comment_orientation": [
            "Custom-mode only: initial_orientation overrides alpha_0 when set.",
            "Accepts exactly one of {quaternion:[w,x,y,z],",
            "                        axis_angle:{axis:[x,y,z], angle_rad:t},",
            "                        euler_zyx:[yaw,pitch,roll]}."
        ],
        "initial_orientation": {
            "euler_zyx": [0.0, 0.0, 0.0]
        },

        "attachment_sites": [
            {
                "position": [-1.25e-6, 0, 0],
                "direction": [-1, 0, 0],
                "label": "left_pole"
            },
            {
                "position": [1.25e-6, 0, 0],
                "direction": [1, 0, 0],
                "label": "right_pole"
            }
        ],

        "pili": [
            {
                "points_file": "geometry/example_pilus_linear.csv",
                "site_index": 1,
                "deflection_z": 0,
                "deflection_x": 0,
                "intrinsic_curvature": "frozen",
                "active_moment": { "type": "off" },
                "root_coupling": "clamped",
                "motor_torque":  { "type": "off" }
            },
            {
                "points_file": "geometry/example_pilus_helix.csv",
                "site_index": 2,
                "deflection_z": 0.1,
                "deflection_x": 0,
                "intrinsic_curvature": "frozen",
                "active_moment": { "type": "off" },
                "root_coupling": "clamped",
                "motor_torque":  { "type": "off" }
            }
        ]
    },

    "material": {
        "E": 3.279e8,
        "r_pili": 3e-9,
        "sigma_p": 0.2
    },

    "fluid": {
        "mu": 1e-3,
        "rho_bac": 1180.0,
        "rho_fluid": 998.232
    },

    "simulation": {
        "T_obs": 5.0,
        "AbsTol": 1e-4,
        "RelTol": 1e-4,
        "delta_frac": 20,
        "tlim": 3600,
        "dt": 0.1,
        "seg_per_um": 10
    },

    "brownian": {
        "enable": false,
        "temperature": 293.15,
        "dt_B_ratio": 0.5
    },

    "output": {
        "preview_initial": true,
        "generate_animation": true,
        "animation_fps": 30,
        "animation_skip": 1,
        "auto_confirm": false,
        "compute_flowfield": false
    },

    "flowfield": {
        "grid_spacing_um": 0.05,
        "grid_range_um": 10.0,
        "quiver_skip": 5,
        "chunk_size": 2000
    },

    "background_flow": {
        "type": "off",
        "U_max": 0,
        "direction": [1, 0, 0],
        "shear_axis": [0, 0, 1],
        "shear_height_m": 0
    }
}
