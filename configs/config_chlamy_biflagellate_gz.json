{
    "case_name": "Chlamy-Biflagellate-GZ",

    "geometry_mode": "custom",

    "_comment_case": [
        "Stage 3 (measured mean shape): two mirror-symmetric flagella beating in synchrony (breaststroke)",
        "on a prolate-spheroid cell body, CC-124 / CC-125.  The rest shape is the measured time-averaged",
        "flagellar shape of swimming cells in water (Qin et al. 2015; Gutierrez et al. 2025), attachment site",
        "at 13 deg from the cell axis, root half-angle 13 deg (geometry/generate_chlamydomonas_geometry.m,",
        "shape_mode = 'gutierrez').",
        "Mirror symmetry: the -Y flagellum has the mirrored rest shape (chlamy_flagellum_cw_gz.csv)",
        "and phase_rad = pi, so its curvature is the exact mirror of the +Y flagellum.",
        "The traveling_wave entries below are PLACEHOLDERS.  The beat is driven by the tracked",
        "measured-gait table chlamydomonas/data/fit_1p00A.mat (with optional 3-D out-of-plane",
        "envelope) injected by chlamydomonas/core/chlamy_run_case.m or chlamydomonas/chlamy_run_preset.m.",
        "Benchmarks: mean swimming speed ~ 100-128 um/s at 50 Hz in the literature; the measured cells of",
        "Qin et al. 2015 in water (58-66 Hz) swim at about 165-189 um/s."
    ],

    "custom_geometry": {
        "body_points_file": "geometry/chlamy_body_spheroid.csv",
        "L_0_override": null,
        "L_0_suggest_mode": "volume",
        "eps_body": null,

        "initial_orientation": {
            "euler_zyx": [0.0, 0.0, 0.0]
        },

        "attachment_sites": [
            {
                "position": [4.871850e-6, 0.8998042e-6, 0],
                "direction": [0.974370, 0.224951, 0],
                "label": "basal_body_plusY"
            },
            {
                "position": [4.871850e-6, -0.8998042e-6, 0],
                "direction": [0.974370, -0.224951, 0],
                "label": "basal_body_minusY"
            }
        ],

        "pili": [
            {
                "_comment": "+Y flagellum (cis/trans assignment is not imposed in the symmetric baseline).",
                "points_file": "geometry/chlamy_flagellum_ccw_gz.csv",
                "site_index": 1,
                "deflection_z": 0,
                "deflection_x": 0,
                "intrinsic_curvature": "frozen",
                "active_moment": {
                    "type": "traveling_wave",
                    "amplitude_Nm": 1.0e-15,
                    "omega_Hz": 50,
                    "wavenumber": 6.283185,
                    "d1_amp": 0,
                    "d2_amp": 1,
                    "d3_amp": 0,
                    "phase_rad": 0
                },
                "root_coupling": "clamped",
                "motor_torque": { "type": "off" }
            },
            {
                "_comment": "-Y flagellum: mirrored rest shape; phase_rad = pi flips the sign of the d2 moment (d2 = +Z for both).",
                "points_file": "geometry/chlamy_flagellum_cw_gz.csv",
                "site_index": 2,
                "deflection_z": 0,
                "deflection_x": 0,
                "intrinsic_curvature": "frozen",
                "active_moment": {
                    "type": "traveling_wave",
                    "amplitude_Nm": 1.0e-15,
                    "omega_Hz": 50,
                    "wavenumber": 6.283185,
                    "d1_amp": 0,
                    "d2_amp": 1,
                    "d3_amp": 0,
                    "phase_rad": 3.141593
                },
                "root_coupling": "clamped",
                "motor_torque": { "type": "off" }
            }
        ]
    },

    "material": {
        "E": 4.3808e6,
        "r_pili": 0.125e-6,
        "sigma_p": 0.2
    },

    "fluid": {
        "mu": 1e-3,
        "rho_bac": 998.232,
        "rho_fluid": 998.232
    },

    "simulation": {
        "T_obs": 0.2,
        "AbsTol": 1e-4,
        "RelTol": 1e-4,
        "delta_frac": 20,
        "tlim": 144000,
        "dt": 0.001,
        "seg_per_um": 6
    },

    "brownian": {
        "enable": false,
        "temperature": 293.15,
        "dt_B_ratio": 0.5
    },

    "output": {
        "preview_initial": true,
        "generate_animation": true,
        "animation_fps": 30,
        "animation_skip": 1,
        "auto_confirm": false,
        "compute_flowfield": false
    },

    "flowfield": {
        "grid_spacing_um": 0.05,
        "grid_range_um": 10.0,
        "quiver_skip": 5,
        "chunk_size": 2000
    },

    "background_flow": {
        "type": "off",
        "U_max": 0,
        "direction": [1, 0, 0],
        "shear_axis": [0, 0, 1],
        "shear_height_m": 0
    }
}
